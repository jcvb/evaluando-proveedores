# =============================================================================
# LOCAL (Docker): dos contenedores independientes
#   proveedores-pg-dev   :54329  →  npm run up / npm run dev
#   proveedores-pg-prod  :54330  →  pruebas locales de "prod"
# =============================================================================

APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/proveedores_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:54329/proveedores_dev

# Auth y Storage. Vacío = sesión local (solo desarrollo) y fotos en public/evidencias.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

ADMIN_EMAILS=admin@ejemplo.com
SESSION_SECRET=cambia-esta-cadena

# Opcional: Places API (New) + Geocoding
GOOGLE_MAPS_API_KEY=

# Opcional: verificación Search Console / Bing Webmaster
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Opcional: correo del aviso de privacidad / términos (si no, usa el primer ADMIN_EMAILS)
LEGAL_CONTACT_EMAIL=

# =============================================================================
# PRODUCCIÓN FREE (Vercel + Supabase) → copia esto a .env.production
# Guía completa: DEPLOY.md
# =============================================================================
#
# APP_ENV=production
# DATABASE_URL=postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-REGION.supabase.com:5432/postgres
# NEXT_PUBLIC_SUPABASE_URL=https://TU_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SITE_URL=https://TU-PROYECTO.vercel.app
