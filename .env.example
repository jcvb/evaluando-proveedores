# Hay dos bases en el Postgres local (puerto 54329):
#   proveedores_dev   la usa `npm run dev`
#   proveedores_prod  la usa `npm start` y los comandos db:*:prod
#
# Copia este archivo a .env.development y .env.production
# y cambia solo las URLs de la base que corresponda.
# En Supabase, DATABASE_URL es el pooler y DIRECT_URL el puerto 5432.

APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/proveedores_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:54329/proveedores_dev

# Producción (ejemplo, no lo mezcles en el archivo de desarrollo):
# APP_ENV=production
# DATABASE_URL=postgresql://postgres:postgres@localhost:54329/proveedores_prod
# DIRECT_URL=postgresql://postgres:postgres@localhost:54329/proveedores_prod

# Auth y Storage. Si se dejan vacíos, en desarrollo hay sesión local
# y las fotos se guardan en public/evidencias.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correos que entran como ADMIN al registrarse o sincronizarse.
ADMIN_EMAILS=admin@ejemplo.com

# Firma de la sesión local de desarrollo.
SESSION_SECRET=cambia-esta-cadena

# Google Maps Platform (opcional). Activa Places API (New) y Geocoding API.
# Sirve para cruzar nombre + dirección al publicar una opinión.
GOOGLE_MAPS_API_KEY=
