{
  "name": "evaluando-proveedores",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "scripts": {
    "up": "node scripts/dev-up.mjs",
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "postinstall": "prisma generate",
    "check:deploy": "node scripts/check-deploy.mjs",
    "db:up": "docker compose up -d --wait postgres-dev",
    "db:up:prod": "docker compose up -d --wait postgres-prod",
    "db:down": "docker compose stop postgres-dev",
    "db:down:prod": "docker compose stop postgres-prod",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/with-env.mjs development -- npx prisma migrate dev",
    "db:migrate:prod": "node scripts/with-env.mjs production -- npx prisma migrate deploy",
    "db:seed": "node scripts/with-env.mjs development -- node prisma/seed.mjs",
    "db:seed:prod": "node scripts/with-env.mjs production -- node prisma/seed.mjs",
    "db:import-sepomex": "node scripts/with-env.mjs development -- node prisma/import-sepomex.mjs",
    "db:import-sepomex:prod": "node scripts/with-env.mjs production -- node prisma/import-sepomex.mjs",
    "db:import-xaltipa": "node scripts/with-env.mjs development -- node prisma/import-xaltipa.mjs",
    "db:import-xaltipa:prod": "node scripts/with-env.mjs production -- node prisma/import-xaltipa.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.91.0",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
